# Public browser-safe values
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only values. The service-role key is used by the ingestion worker to
# write chunks; it must never be exposed to browser code.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# Chat/vision model. Must support the Responses API, structured outputs, and
# PDF/image input (OCR runs through it). Defaults to gpt-4.1-mini.
OPENAI_CHAT_MODEL=gpt-4.1-mini
# Must produce 1536 dimensions to match the pgvector column.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: self-hosted Ollama (https://ollama.com), e.g. http://127.0.0.1:11434.
# Zero-cost chat fallback used only when neither OPENAI_API_KEY nor
# AI_GATEWAY_API_KEY is set. Chat only — Ollama's local embedding models don't
# match the pgvector column's 1536 dimensions, so RAG/embeddings still require
# OPENAI_API_KEY or AI_GATEWAY_API_KEY regardless of this setting. Chat model
# defaults to llama3.1; override with OPENAI_CHAT_MODEL (e.g. llama3.2).
OLLAMA_BASE_URL=

# Optional tuning
STUDIGO_MAX_RETRIEVAL_CHUNKS=8
STUDIGO_MIN_SIMILARITY=0.35

# Optional: URL of the local zero-cost retrieval service (services/retrieval).
# When set, every successful document ingestion also mirrors its pages into
# that service's FAISS index, and POST /api/flashcards/local becomes usable
# (rule-based cloze/true-false cards, no OPENAI_API_KEY required). This
# service must be deployed somewhere that supports persistent processes and
# disk (a VPS, Railway, Fly.io, ...) — it is too large for Vercel's
# serverless function size limit (torch + sentence-transformers), so it
# cannot run inside this Next.js app's own deployment.
RETRIEVAL_SERVICE_URL=

# Server-only bearer secret for daily durable storage cleanup.
CRON_SECRET=
