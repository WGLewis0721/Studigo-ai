{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "app-profile.schema.json",
  "title": "Security readiness app profile",
  "description": "What an app is and does, as yes/no/unknown capability flags. Drives which controls apply.",
  "type": "object",
  "required": [
    "schema_version",
    "app_id",
    "name",
    "features"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "app_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "client": {
      "type": "string",
      "description": "Client or business unit, for portfolio grouping."
    },
    "owner": {
      "type": "string"
    },
    "stage": {
      "enum": [
        "idea",
        "prototype",
        "beta",
        "production"
      ]
    },
    "platforms": {
      "type": "array",
      "items": {
        "enum": [
          "supabase",
          "vercel",
          "nextjs",
          "openai",
          "stripe"
        ]
      },
      "description": "Enables platform-specific guidance in actions."
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "features": {
      "type": "object",
      "properties": {
        "web": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "api": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "authentication": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "oauth": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "public_signup": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "multi_tenant": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "file_uploads": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "cloud_storage": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "ai": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "external_ai_provider": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "rag": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "vector_store": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "ai_tools_or_agents": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "expensive_compute": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "outbound_fetch": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "webhooks": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "user_generated_content": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "sensitive_data": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "minors": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "payments": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "admin_console": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "third_party_integrations": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "auxiliary_services": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        }
      },
      "additionalProperties": {
        "enum": [
          "yes",
          "no",
          "unknown"
        ]
      }
    },
    "data_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "deployment_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
