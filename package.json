{
  "name": "studigo",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "pnpm --filter @studigo/web dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @studigo/web build",
    "lint": "node scripts/check-ai-boundary.mjs && node scripts/check-engineering-paths.mjs",
    "typecheck": "pnpm -r typecheck",
    "desktop:dev": "pnpm --filter @studigo/desktop tauri dev",
    "desktop:build": "pnpm --filter @studigo/desktop tauri build",
    "test": "pnpm -r test && node --test tests/database-security.test.mjs && node --test evals/rag/*.test.mjs && node --test evals/grading/*.test.mjs && node --test implementation/security-readiness/scripts/*.test.mjs",
    "test:rag": "node --test evals/rag/*.test.mjs",
    "test:ml": "python -m unittest discover -s evals/ml -p test_*.py",
    "test:security": "node --test tests/database-security.test.mjs",
    "beta": "node scripts/local-beta.mjs",
    "security:report": "node implementation/security-readiness/scripts/security-readiness.mjs report --all && node implementation/security-readiness/scripts/security-readiness.mjs portfolio",
    "security": "node implementation/security-readiness/scripts/security-readiness.mjs",
    "security:check": "node implementation/security-readiness/scripts/security-readiness.mjs check"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "playwright": "1.62.1"
  },
  "pnpm": {
    "overrides": {
      "sharp@<0.35.5": "0.35.5",
      "source-map-js@<1.2.2": "1.2.2"
    }
  }
}
