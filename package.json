{
  "name": "studigo",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "pnpm --filter @studigo/web dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @studigo/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "desktop:dev": "pnpm --filter @studigo/desktop tauri dev",
    "desktop:build": "pnpm --filter @studigo/desktop tauri build",
    "test": "pnpm -r test && node --test tests/database-security.test.mjs && node --test evals/rag/*.test.mjs",
    "test:rag": "node --test evals/rag/*.test.mjs",
    "test:security": "node --test tests/database-security.test.mjs",
    "beta": "node scripts/local-beta.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "playwright": "1.62.1"
  }
}
